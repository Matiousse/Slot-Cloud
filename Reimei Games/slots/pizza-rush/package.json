{
  "name": "pizza-rush",
  "version": "1.0.0",
  "private": true,
  "description": "PIZZA RUSH - Reimei Games slot for Stake Engine (math + frontend)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "assets": "python3 scripts/assets.py",
    "math:stats": "tsx math/stats.ts",
    "math:generate": "tsx math/generate.ts",
    "math:verify": "tsx math/verify.ts",
    "math": "npm run math:generate && npm run math:verify"
  },
  "engines": { "node": ">=22.15" },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
