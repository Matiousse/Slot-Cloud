{
  "name": "kitsune-rising",
  "version": "1.0.0",
  "private": true,
  "description": "KITSUNE RISING - Reimei Games slot for Stake Engine (math)",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "math:stats": "tsx math/stats.ts",
    "math:generate": "tsx math/generate.ts",
    "math:verify": "tsx math/verify.ts",
    "math": "npm run math:generate && npm run math:verify"
  },
  "engines": { "node": ">=22.15" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
