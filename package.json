{
  "name": "cloudburst-slot",
  "version": "1.0.0",
  "private": true,
  "description": "CLOUDBURST - 5x5 Storm Wilds video slot for Stake Engine (math + frontend)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "math:stats": "tsx math/stats.ts",
    "math:generate": "tsx math/generate.ts",
    "math:verify": "tsx math/verify.ts",
    "math": "npm run math:generate && npm run math:verify"
  },
  "engines": {
    "node": ">=22.15"
  },
  "devDependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/lilita-one": "5.3.0",
    "@fontsource/luckiest-guy": "5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.180.0",
    "opentype.js": "^1.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vite-plugin-singlefile": "2.3.3"
  },
  "dependencies": {
    "three": "^0.180.0"
  }
}
